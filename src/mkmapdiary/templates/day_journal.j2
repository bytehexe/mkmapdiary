{% if assets %}
## {{ strings.journal_title }}

{% for asset in assets %}
<div class="journal-entry" id="asset-{{ asset.id }}" markdown>
{% if asset.type == "markdown" %}
--8<-- "docs/assets/{{ asset.path }}:1:1"
{% elif asset.type == "audio" %}
--8<-- "docs/assets/{{ asset.path }}.md:1:1"
{% endif %}
<div class="metadata">
<span title="{{ strings.meta_time }}"><i class="iconoir iconoir-clock"></i> {{ asset.time }}</span>
{%- if asset.timezone %} · <span title="{{ strings.meta_timezone }}"><i class="iconoir iconoir-time-zone"></i> {{ asset.timezone }}</span>{% endif %}
{%- if asset.location %} · <span title="{{ strings.meta_location }}"><i class="iconoir iconoir-map-pin"></i> <a href="#" class="location-link" data-lat="{{ asset.latitude }}" data-lng="{{ asset.longitude }}">{{ asset.location }}</a></span>{% endif %}
{%- if asset.location_admin %} · <span title="{{ strings.meta_location_admin }}"><i class="iconoir iconoir-map"></i> {{ asset.location_admin }}</span>{% endif %}
{#- the icon names the instrument of creation, so it cannot be misread as the person in the recording -#}
{%- if show_creators and asset.creator %} ·
{%- if asset.type == "audio" %}{% set creator_icon, creator_title = "microphone", strings.meta_creator_audio %}
{%- elif asset.type == "markdown" %}{% set creator_icon, creator_title = "edit-pencil", strings.meta_creator_text %}
{%- else %}{% set creator_icon, creator_title = "user", strings.meta_creator %}{% endif %} <span title="{{ creator_title }}"><i class="iconoir iconoir-{{ creator_icon }}"></i> {{ asset.creator }}</span>{% endif %}
</div>
{% if asset.type == "markdown" %}
--8<-- "docs/assets/{{ asset.path }}:2"
{% elif asset.type == "audio" %}
<div class="audio-section">
<audio controls>
  <source src="assets/{{ asset.path }}" type="audio/mpeg">
  Your browser does not support the audio element.
</audio>
--8<-- "docs/assets/{{ asset.path }}.md:2"
</div>
{% endif %}
</div>
{% endfor %}
{% endif %}